#!/usr/bin/env bash
# The thesis, made measurable.
#
# A workflow completed in a namespace this platform provisioned, started after this
# challenge began. Nothing about how it was done -- only that the paved road worked
# for somebody who had not built it.
set -uo pipefail
source /etc/workshop/env
fail() { echo "$1" >&2; exit 1; }

STARTED_AT_FILE=/tmp/challenge5-started
[ -f "$STARTED_AT_FILE" ] || date +%s > "$STARTED_AT_FILE"
STARTED_AT=$(cat "$STARTED_AT_FILE")

FOUND=""
for SPEC in specs/*.yaml; do
  case "$SPEC" in *_example*) continue;; esac
  NAME=$(grep '^name:' "$SPEC" | awk '{print $2}')
  NS="ws-${WORKSHOP_USERNAME}-${NAME}-staging"

  COUNT=$(temporal workflow list --namespace "$NS" \
            --query "ExecutionStatus = 'Completed'" -o json 2>/dev/null \
          | jq -r '[.[]?] | length')
  if [ "${COUNT:-0}" -ge 1 ]; then FOUND="$NS"; break; fi
done

[ -n "$FOUND" ] || fail "No completed workflow in any namespace your platform provisioned yet."

ELAPSED=$(( $(date +%s) - STARTED_AT ))
printf 'ok: a workflow completed in %s\n' "$FOUND"
printf '\n    time to first workflow: %dm %ds\n\n' $((ELAPSED/60)) $((ELAPSED%60))
echo "    OpenAI's number, before their paved road, was one to two weeks."
