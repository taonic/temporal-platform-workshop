#!/usr/bin/env bash
set -uo pipefail
source /etc/workshop/env
fail() { echo "$1" >&2; exit 1; }

SPEC=$(ls specs/*.yaml 2>/dev/null | grep -v '_example' | head -1)
[ -n "$SPEC" ] || fail "No spec found."
NAME=$(grep '^name:' "$SPEC" | awk '{print $2}')

for ENV in staging prod; do
  NS="ws-${WORKSHOP_USERNAME}-${NAME}-${ENV}"
  temporal cloud namespace get --name "$NS" -o json >/dev/null 2>&1 \
    || fail "Namespace $NS does not exist. One spec should fan out to both environments."

  # A namespace-scoped service account, not an account-level one. This is the
  # least-privilege claim the challenge makes, so it is the one graded.
  SA=$(temporal cloud service-account list -o json 2>/dev/null \
        | jq -r --arg n "${NS}-worker" '.serviceAccounts[]? | select(.spec.name==$n)')
  [ -n "$SA" ] || fail "No service account named ${NS}-worker."
  echo "$SA" | jq -e '.spec.access.namespaceScopedAccess != null' >/dev/null 2>&1 \
    || fail "${NS}-worker is not namespace-scoped. A worker needs no account-level access."

  # The credential must exist in Vault, because that is where the platform put it.
  vault kv get -field=api_key "secret/namespaces/${WORKSHOP_USERNAME}/${NAME}/${ENV}" >/dev/null 2>&1 \
    || fail "No credential in Vault at namespaces/${WORKSHOP_USERNAME}/${NAME}/${ENV}."
done

echo "ok: two namespaces, two namespace-scoped identities, two credentials in Vault"
