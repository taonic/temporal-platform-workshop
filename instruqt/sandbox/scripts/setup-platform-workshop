#!/usr/bin/env bash
# Sandbox prebuild.
#
# This runs on the sandbox itself, once, while it starts -- not at `sandbox
# publish`, which builds nothing and returns in a second. So everything below is
# time a student spends watching the loading screen, and the trade it makes is
# always the same: move a wait out of a challenge, where it looks like a hung
# workflow, into a loading screen, where it looks like a loading screen.
#
# Three lines earn their place more than the rest: the warm Terraform provider
# cache, the first k3s start, and the two container images. A cold `terraform
# init` against temporalio/temporalcloud is a silent two-minute stall on the very
# first apply; a cold k3s start pulls coredns and friends at the first prompt of
# the day.
#
# What this does NOT do, on purpose:
#
#   * No Vault. It runs as a pod on k3s (deploy/platform/vault.yaml), and
#     `workshop init --api-key` is what brings it up -- at the moment the student
#     pastes the key, which is the only moment anybody holds it. This script runs
#     before there is a key to seed, so bringing Vault up here would only move
#     thirty seconds of waiting from a step that explains itself into a loading
#     screen that does not. A host `vault server -dev` on 8200 used to run here as
#     well; nothing addressed it, because $VAULT_ADDR is the NodePort.
#
#   * No Temporal dev server, and no host copy of the control plane. Both used to
#     be here, from before this workshop ran against Temporal Cloud. The control
#     plane is a Deployment the STUDENT creates in challenge 2, on the namespace
#     their own Terraform made in challenge 1 -- that bootstrap is the punchline,
#     and a control plane already running against a local dev server gives it
#     away and answers to the wrong Temporal.
#
#   * No API key. There is none to seed: the platform's service account is
#     something the student creates in challenge 1, in the sandbox exactly as on
#     a laptop.
set -euo pipefail

log() { printf '\n=== %s\n' "$*"; }

# The `environment:` block in sandbox/config.yml is NOT in scope here.
#
# Learned from a real preset build: this script reached `=== clone the platform`
# and died on `LAB_REPO_URL: unbound variable`. That block is what a student's
# shell gets; a preset's setup script runs earlier and elsewhere, at image build
# time, and sees none of it.
#
# So the two values needed BEFORE there is a checkout are defaulted here. Nothing
# else is: everything further down reads sandbox/config.yml itself, once the clone
# has made it readable, so the config stays the one place those values are written.
# These two cannot work that way -- they are how the checkout is obtained -- so
# they are the one duplicated set in the sandbox, and the check after the clone
# asserts they still agree with the config rather than trusting that they do.
LAB_REPO_URL="${LAB_REPO_URL:-https://github.com/taonic/temporal-platform-workshop.git}"
LAB_REPO_REF="${LAB_REPO_REF:-main}"
WORKSHOP_DIR="${WORKSHOP_DIR:-/workspace/platform}"

# Pinned, every one of them. A tool that changes under a cohort is a tool that
# breaks a lab, and the failure lands on a student who has no way to know the
# instruction was fine yesterday.
GO_VERSION=1.25.4
TF_VERSION=1.9.8
VAULT_VERSION=1.18.3          # must match deploy/platform/vault.yaml; asserted below
TEMPORAL_CLI_VERSION=1.8.2
CLOUD_CLI_VERSION=0.0.4       # `temporal cloud` -- a SEPARATE binary; see below
UV_VERSION=0.12.7
K9S_VERSION=v0.32.7
CODE_SERVER_VERSION=4.135.0
K3S_CHANNEL=v1.31

log "system packages"
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
# make: the Makefile is where the work is defined and `workshop <verb>` forwards
# to it, so a sandbox without make has no working front door.
# sudo: deploy/platform/up.sh and the graders call `sudo k3s ...`, which fails
# with "command not found" rather than a permission error when it is absent.
# nano, vim: what a student who does not want the editor reaches for, and what
# the `code` shim below tells them about when the editor is not open yet.
apt-get install -y -qq curl git jq unzip make sudo nano vim ca-certificates >/dev/null

log "go toolchain"
curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" | tar -C /usr/local -xz
export PATH=/usr/local/go/bin:$PATH

log "uv"
curl -fsSL "https://astral.sh/uv/${UV_VERSION}/install.sh" | sh
export PATH="/root/.local/bin:$PATH"

log "terraform"
curl -fsSL -o /tmp/tf.zip "https://releases.hashicorp.com/terraform/${TF_VERSION}/terraform_${TF_VERSION}_linux_amd64.zip"
unzip -q -o /tmp/tf.zip -d /usr/local/bin && rm /tmp/tf.zip

log "vault cli"
# The CLI only, not a server. It talks to the Vault pod on the NodePort.
curl -fsSL -o /tmp/vault.zip "https://releases.hashicorp.com/vault/${VAULT_VERSION}/vault_${VAULT_VERSION}_linux_amd64.zip"
unzip -q -o /tmp/vault.zip -d /usr/local/bin && rm /tmp/vault.zip

log "temporal cli"
curl -fsSL https://temporal.download/cli.sh | sh -s -- --version "$TEMPORAL_CLI_VERSION" --dir /usr/local
ln -sf /usr/local/bin/temporal /usr/bin/temporal 2>/dev/null || true

log "temporal cloud extension"
# `temporal cloud` is a SEPARATE BINARY, not part of the CLI.
#
# This is the single most common thing to arrive without, and it was wrong here
# too: the comment this replaces claimed `cloud` was built into the CLI from 1.5,
# which is what a laptop with the Homebrew `temporal-cloud` formula installed
# looks like. A sandbox without it has a `cloud` command group that answers
# `--help` and then says "unknown command" for every actual subcommand.
#
# The `temporal` CLI discovers `temporal-cloud` on PATH and re-exposes it as
# `temporal cloud ...`, so installing the binary is the whole of the integration.
# The release publishes checksums, and a plain Linux tarball -- no brew, no Go
# toolchain. https://github.com/temporalio/cloud-cli/releases
CLOUD_TGZ="temporal_cloud_cli_${CLOUD_CLI_VERSION}_linux_amd64.tar.gz"
CLOUD_BASE="https://github.com/temporalio/cloud-cli/releases/download/v${CLOUD_CLI_VERSION}"
curl -fsSL -o /tmp/temporal-cloud.tgz "$CLOUD_BASE/$CLOUD_TGZ"
# Verified, because this is the one binary here fetched from a release rather than
# through a vendor's own installer.
CLOUD_WANT="$(curl -fsSL "$CLOUD_BASE/checksums.txt" | awk -v n="$CLOUD_TGZ" '$2 == n {print $1}')"
[ -n "$CLOUD_WANT" ] || { echo "FAIL $CLOUD_TGZ has no entry in checksums.txt" >&2; exit 1; }
echo "$CLOUD_WANT  /tmp/temporal-cloud.tgz" | sha256sum -c -
tar -xzf /tmp/temporal-cloud.tgz -C /tmp temporal-cloud
install -m 0755 /tmp/temporal-cloud /usr/local/bin/temporal-cloud
rm -f /tmp/temporal-cloud.tgz /tmp/temporal-cloud

# Asserted on a REAL subcommand. `temporal cloud --help` succeeds with no plugin
# installed at all -- it is the group, and cobra prints it happily -- so the check
# that used to live here proved nothing and passed a sandbox where challenge 1's
# first verification command was broken. `whoami` is the one that lab runs.
temporal cloud whoami --help >/dev/null

log "k9s"
# A terminal UI for the cluster. Not required by any command in the workshop, but
# challenge 2 says "look at what you just built" and this is what it says to look
# with -- and a student who has never used Kubernetes gets a way to see what the
# platform made that does not involve memorising kubectl.
curl -fsSL -o /tmp/k9s.tar.gz \
  "https://github.com/derailed/k9s/releases/download/${K9S_VERSION}/k9s_Linux_amd64.tar.gz"
tar -C /usr/local/bin -xzf /tmp/k9s.tar.gz k9s && rm /tmp/k9s.tar.gz

log "code-server, and the \`code\` command the labs type"
# Four lab steps are `code <file>`, and until now nothing in this sandbox could
# answer that -- while the challenge already advertised an Editor tab on 8443
# with nothing serving it.
#
# --auth none: the tab is proxied to the participant's own session, and a
# password prompt in front of it is a step the labs would have to explain. Note
# what that means: on a sandbox with high-ports open, this editor is a root
# filesystem behind no credential. Acceptable for a per-student box that is
# deleted at the end of the day; not a pattern to copy anywhere else.
curl -fsSL https://code-server.dev/install.sh | sh -s -- --version "$CODE_SERVER_VERSION"

# Dark, and settled before the editor ever starts.
#
# $HOME is /root for the unit below, so this is the User settings path
# code-server reads. autoDetectColorScheme is named explicitly rather than left
# at its default: it takes the theme from the BROWSER's prefers-color-scheme,
# which would hand a student on a light laptop a light editor no matter what is
# set here.
#
# "Default Dark+" rather than the newer "Default Dark Modern": both are built in,
# but a colorTheme naming a theme this build does not ship falls back silently
# rather than erroring, and Dark+ has shipped in every VS Code for years and is
# what the temporal-cloud-training-portal track already runs on code-server.
mkdir -p /root/.local/share/code-server/User
cat > /root/.local/share/code-server/User/settings.json <<'SETTINGS'
{
  "workbench.colorTheme": "Default Dark+",
  "window.autoDetectColorScheme": false
}
SETTINGS

cat > /etc/systemd/system/code-server.service <<UNIT
[Unit]
Description=code-server, the Editor tab
After=network.target

[Service]
Environment=HOME=/root
# --cert, so this is HTTPS. Instruqt's service tab proxies 8443 as TLS: without
# it the listener answers a local curl perfectly and the tab sits on "We're
# trying to connect to the service, but it seems like it's not quite ready yet".
# Self-signed, generated on first start, and never seen by a student -- the
# proxy terminates it.
ExecStart=/usr/bin/code-server --bind-addr 0.0.0.0:8443 --cert --auth none \\
  --disable-telemetry --disable-update-check --disable-workspace-trust $WORKSHOP_DIR
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
UNIT

# `code <file>` from the Terminal tab, landing in the Editor tab.
#
# VS Code's CLI does not open files by itself -- it asks a running window to,
# over a unix socket named by $VSCODE_IPC_HOOK_CLI. Inside the Editor tab's own
# terminal that variable is already set and the real CLI just works. The Terminal
# tab is a different session and does not have it, so find the socket the editor
# left behind and use that.
#
# When no window has ever been opened there is no socket and nothing to open the
# file IN. That case says so, in the vocabulary of the tabs the student can see,
# rather than failing as `code: command not found` or silently doing nothing.
cat > /usr/local/bin/code <<'SHIM'
#!/usr/bin/env bash
set -uo pipefail
# Discovered, not hardcoded. The file under remote-cli/ is `code-server` in
# current releases and was `code` in older ones, and the tree lives in
# /usr/lib/code-server for the .deb and under ~/.local/lib for a standalone
# install. Guessing one of those produced "code-server is not installed" on a
# machine where it was installed and running.
CLI="$(find /usr/lib/code-server /usr/local/lib/code-server "$HOME/.local/lib" \
        -maxdepth 7 -type f -path '*remote-cli*' 2>/dev/null | head -1)"
if [ -z "${CLI:-}" ] || [ ! -x "$CLI" ]; then
  echo "Could not find code-server's remote CLI, so \`code\` cannot hand it a file." >&2
  echo "Open ${1:-the file} from the Editor tab, or use nano/vim." >&2
  exit 1
fi

if [ -n "${VSCODE_IPC_HOOK_CLI:-}" ]; then exec "$CLI" "$@"; fi

sock=$(ls -t /tmp/vscode-ipc-*.sock /run/user/*/vscode-ipc-*.sock 2>/dev/null | head -1)
if [ -n "${sock:-}" ]; then exec env VSCODE_IPC_HOOK_CLI="$sock" "$CLI" "$@"; fi

cat >&2 <<MSG
The Editor tab has not been opened yet, so there is no editor window for
${1:-that file} to open in.

  Click the Editor tab at the top of this screen once -- it opens
  ${WORKSHOP_DIR:-/workspace/platform} -- then run this command again and the file appears in it.

Or just open the file in the tree there. nano and vim are installed if you
would rather stay in the terminal.
MSG
exit 1
SHIM
chmod +x /usr/local/bin/code

systemctl daemon-reload
# --now as well as --enable: this proves it starts, here, rather than at boot in
# front of a student with no build log to read.
systemctl enable --now code-server
for _ in $(seq 1 30); do curl -fsSk --max-time 2 -o /dev/null https://127.0.0.1:8443/healthz && break; sleep 1; done
curl -fsSk --max-time 5 -o /dev/null https://127.0.0.1:8443/healthz \
  || { echo "FAIL code-server is not answering https on 8443; the Editor tab would not connect" >&2
       systemctl status code-server --no-pager >&2 || true
       exit 1; }

log "k3s"
# Installed here, started further down -- once the images are staged where its
# containerd will import them at startup.
#
# It IS started during the build now, which is a change worth being explicit
# about: this used to be installed and left stopped, from when the cluster first
# appeared in challenge 4. Vault runs on it, and `workshop init --api-key` is the
# first command of the day, so it is challenge-1 material -- and a first k3s start
# pulls coredns, traefik, the local-path provisioner and metrics-server before it
# will schedule anything. That pull belongs in a preset build.
curl -fsSL https://get.k3s.io | INSTALL_K3S_CHANNEL="$K3S_CHANNEL" INSTALL_K3S_SKIP_START=true sh -

log "clone the platform"
mkdir -p "$(dirname "$WORKSHOP_DIR")"
git clone --depth 1 --branch "$LAB_REPO_REF" "$LAB_REPO_URL" "$WORKSHOP_DIR"
cd "$WORKSHOP_DIR"
# The post-commit hook runs `tpctl sync`, which is how challenge 3's "commit a
# spec and the platform converges" works at all.
git config core.hooksPath hooks

# Now that the config is on disk, read what a student's shell will be given --
# rather than keeping a second copy of it in here.
#
# One `environment:` value per line, `NAME: value`, so awk is enough and pulling in
# a YAML parser is not. An env var still wins where one is set, because that is how
# a human overrides a build without editing either file.
cfg_env() { # cfg_env NAME -- the value sandbox/config.yml gives a student's shell
  awk -v k="$1:" '$1==k {gsub(/"/,"",$2); print $2; exit}' instruqt/sandbox/config.yml
}

for v in LAB_REPO_URL LAB_REPO_REF WORKSHOP_DIR; do
  want="$(cfg_env "$v")"; have="${!v}"
  [ -z "$want" ] || [ "$want" = "$have" ] || {
    echo "FAIL $v is \"$have\" in this script but \"$want\" in sandbox/config.yml." >&2
    echo "     These two are needed before the clone exists, so they are the one" >&2
    echo "     duplicated pair here and both copies have to move together." >&2
    exit 1
  }
done

VAULT_ADDR="${VAULT_ADDR:-$(cfg_env VAULT_ADDR)}"
VAULT_DEV_ROOT_TOKEN_ID="${VAULT_DEV_ROOT_TOKEN_ID:-$(cfg_env VAULT_DEV_ROOT_TOKEN_ID)}"
PORTAL_URL="${PORTAL_URL:-$(cfg_env PORTAL_URL)}"
# From the config, not the environment: it used to be an Instruqt secret and is
# now a plain variable, and neither kind reaches a setup script.
PORTAL_LINK_CODE="${PORTAL_LINK_CODE:-$(cfg_env PORTAL_LINK_CODE)}"
WORKSHOP_STRICT_EGRESS="${WORKSHOP_STRICT_EGRESS:-$(cfg_env WORKSHOP_STRICT_EGRESS)}"
: "${VAULT_ADDR:?not set here and not in sandbox/config.yml}"
: "${VAULT_DEV_ROOT_TOKEN_ID:?not set here and not in sandbox/config.yml}"
echo "  repo    $LAB_REPO_URL @ $LAB_REPO_REF"
echo "  vault   $VAULT_ADDR"
echo "  portal  ${PORTAL_URL:-<unset>}"

# The vault CLI installed above and the Vault the cluster runs must be the same
# version. Asserted rather than assumed: they are pinned in two files, and a
# mismatch surfaces as an unrelated-looking API error in front of a room.
VAULT_IMAGE="$(awk '/image: hashicorp\/vault:/ {print $2; exit}' deploy/platform/vault.yaml)"
[ "$VAULT_IMAGE" = "hashicorp/vault:${VAULT_VERSION}" ] || {
  echo "VAULT_VERSION=$VAULT_VERSION here, but deploy/platform/vault.yaml runs $VAULT_IMAGE." >&2
  exit 1
}

# Written HERE, before the slow half, and that placement is the point.
#
# This used to be the second-to-last thing the script did -- at about 277 of 280
# seconds -- and Instruqt attaches a terminal long before setup finishes. A shell
# that starts first reads a .bashrc without these lines in it and sits in /root
# for the rest of the day, with no $WORKSHOP_DIR, no KUBECONFIG and no portal
# link, while the build log says "ready". Everything below needs only the clone
# and the config, both of which are already done, so there is no reason to make a
# student race it.
#
# It does not close the race entirely -- a terminal opened in the first minute
# still predates this -- so `exec bash` remains the fix for a shell that started
# too early.
log "platform environment"
# Its own named block, so that `workshop init` -- which rewrites `# >>> workshop`
# and `# >>> workshop vault` -- cannot delete these lines, and these lines cannot
# delete what it writes. Nothing here is a secret and nothing here is a choice the
# student makes: identity, region and the Cloud address are all `init`'s to write,
# and they come from the portal.
#
# Terraform state is local -- a file under .platform-state in the student's own
# checkout. Nothing to reach, nothing to authenticate to, and debuggable with
# `cat` when an apply goes wrong.
install -d /etc/workshop
cat > /etc/workshop/env <<ENV
# >>> workshop sandbox
export WORKSHOP_DIR=$WORKSHOP_DIR
export WORKSHOP_COHORT=\${WORKSHOP_COHORT:-$(date +%Y-%m)}
# Tags what this box creates, so a teardown can find it. Per participant rather
# than per image: baked at build time it would be one value for the whole cohort.
export WORKSHOP_RUN_ID=\${INSTRUQT_PARTICIPANT_ID:-${INSTRUQT_TRACK_SLUG:-local}}
export VAULT_ADDR=$VAULT_ADDR
export VAULT_TOKEN=$VAULT_DEV_ROOT_TOKEN_ID
# k3s puts its kubeconfig somewhere only it knows about. kubectl is a symlink to
# k3s and finds it on its own; k9s, which challenge 2 asks a student to open, does
# not -- it reads \$KUBECONFIG like any other client and reports "no clusters".
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
# Where the lab material lives. The join link is built from this at shell start,
# not here -- see below.
export PORTAL_URL=$PORTAL_URL
export PORTAL_LINK_CODE="$PORTAL_LINK_CODE"
export PATH=/usr/local/go/bin:/root/.local/bin:$WORKSHOP_DIR/bin:\$PATH
# <<< workshop sandbox
ENV

# Sourced for every shell, and landing in the repo. Every command in every lab is
# written to be run from the repo root -- `./scripts/workshop`, `code
# terraform/...`, `ls specs/*.yaml` -- and Instruqt opens the terminal in /root.
cat > /etc/profile.d/workshop.sh <<'PROFILE'
# Once per shell. A login shell reads /etc/profile.d/*.sh and .bashrc sources this
# too, and without the guard $PATH ends up holding every entry twice.
#
# The guard is on THIS file and not on the env file, deliberately: challenge 1
# tells the student to run `source "$(./scripts/workshop env-file)"` after `init`
# rewrites it, and a sentinel there would make that step do nothing.
if [ -z "${WORKSHOP_ENV_SOURCED:-}" ]; then
  # shellcheck disable=SC1091
  source /etc/workshop/env
  export WORKSHOP_ENV_SOURCED=1
fi
# Only for a shell someone is sitting at. A grader or a hook that sources this
# should get the variables without being moved out of the directory it chose --
# and neither should be shown a join link.
case $- in
  *i*)
    cd "$WORKSHOP_DIR" 2>/dev/null || true

    # The portal link, built HERE rather than baked into the image.
    #
    # This is the one thing a student has to have, and the setup script cannot
    # give it to them: a preset's setup script runs at image build time, so
    # anything it prints goes to a build log nobody in the room will ever see, and
    # neither $PORTAL_URL nor $PORTAL_LINK_CODE is in scope there. Both come out of
    # /etc/workshop/env, sourced just above, which the setup script wrote.
    #
    # Bare on purpose: it cannot be personalised, because the student has not
    # chosen a username yet. They pick one at the portal and bookmark what it
    # hands back.
    if [ -n "${PORTAL_LINK_CODE:-}" ] && [ -n "${PORTAL_URL:-}" ]; then
      printf '\n  Your workshop instructions:\n  %s/join?k=%s\n\n' \
        "$PORTAL_URL" "$PORTAL_LINK_CODE"
    else
      printf '\n  No portal link: PORTAL_LINK_CODE is not set on this sandbox.\n'
      printf '  Ask your instructor for the join link -- the labs are all in there.\n\n'
    fi
    ;;
esac
PROFILE
# Both files, because which one a terminal reads depends on whether it opens a
# login shell, and that is Instruqt's choice rather than ours. The guard above
# makes reading both a no-op; reading neither is a student sitting in /root
# wondering why every command in every lab says "no such file or directory".
cat >> /root/.bashrc <<'BRC'
source /etc/profile.d/workshop.sh
BRC
# shellcheck disable=SC1091
source /etc/workshop/env

log "build the control plane cli"
# tpctl on PATH, because every lab from challenge 2 onward types it bare. The env
# file puts $WORKSHOP_DIR/bin first, so a student who rebuilds it with
# `workshop build` gets their own copy ahead of this one.
go build -o /usr/local/bin/tpctl ./cmd/tpctl
# The rest of the module, to warm the build cache -- and `go mod download` for the
# test-only dependencies `go build` never reaches, so that challenge 2's
# `go build ./...` and `workshop test` are compiles rather than downloads.
go mod download
go build ./...

log "python worker dependencies"
(cd worker && uv sync --extra dev)

log "warm the terraform provider cache"
# This is the line that makes challenge 1 feel instant instead of broken.
mkdir -p /root/.terraform.d/plugin-cache
echo 'plugin_cache_dir = "/root/.terraform.d/plugin-cache"' > /root/.terraformrc
(cd terraform/namespace && terraform init -backend=false -input=false >/dev/null)

log "build the two images, and stage them for k3s"
# TWO images, and they are not interchangeable -- this used to build the Python
# worker and tag it platform-worker:dev, which is the control plane's tag, so the
# control plane pod would have come up running the managed worker.
#
#   platform-worker:dev   the Go control plane (challenge 2). Built through
#                         up.sh so `workshop platform-up` and this agree.
#   managed-worker:dev    the Python worker a product team deploys (challenge 4).
#                         `tpctl deploy` rebuilds it from the student's own
#                         workflow, so what this buys is a warm Docker layer
#                         cache rather than the final image.
./deploy/platform/up.sh build
make worker-image
docker pull "$VAULT_IMAGE"

# k3s runs its own containerd and cannot see the Docker daemon. Tarballs dropped
# here are imported when k3s starts, which is why this happens before the first
# start rather than through `k3s ctr images import` after it.
mkdir -p /var/lib/rancher/k3s/agent/images
docker save platform-worker:dev -o /var/lib/rancher/k3s/agent/images/platform-worker.tar
docker save managed-worker:dev  -o /var/lib/rancher/k3s/agent/images/managed-worker.tar
docker save "$VAULT_IMAGE"      -o /var/lib/rancher/k3s/agent/images/vault.tar

log "start k3s, and let it settle"
# --now is what matters: this script runs on the live sandbox, once, as it starts,
# so nothing here is baked into an image and the cluster has to be up by the time
# it returns. `enable` is insurance for a machine that reboots under a student.
systemctl enable --now k3s
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml

# Wait for a NODE, not for the API server.
#
# `kubectl get nodes` exits 0 the moment the API answers, empty list and all, so a
# loop waiting on it breaks about eleven seconds in -- before the kubelet has
# registered anything -- and the `kubectl wait` below then fails instantly with
# "error: no matching resources found" instead of waiting for what it was asked
# about. Ask for the thing actually needed.
for _ in $(seq 1 120); do
  [ -n "$(kubectl get nodes --no-headers 2>/dev/null)" ] && break
  sleep 2
done
kubectl wait --for=condition=Ready node --all --timeout=300s || {
  echo "FAIL the node never went Ready. What k3s says about it:" >&2
  kubectl get nodes -o wide >&2 || true
  journalctl -u k3s --no-pager 2>/dev/null | tail -40 >&2 || true
  exit 1
}

# Proof the staged images actually landed, while there is still a build log
# nobody is waiting on. Without this the first symptom is ImagePullBackOff in
# front of a student, reported as "pull access denied" for a registry that was
# never involved.
#
# Retried rather than asserted once: k3s imports everything in agent/images
# asynchronously as it starts, and these three are a couple of gigabytes, so the
# store is legitimately still filling for a while after the node reports Ready.
for img in platform-worker:dev managed-worker:dev "$VAULT_IMAGE"; do
  for _ in $(seq 1 60); do
    k3s ctr images ls -q | grep -q "$img" && break
    sleep 5
  done
  k3s ctr images ls -q | grep -q "$img" || {
    echo "FAIL $img is not in k3s's image store after five minutes" >&2
    echo "     staged tarballs:" >&2
    ls -l /var/lib/rancher/k3s/agent/images/ >&2 || true
    exit 1
  }
  echo "  ok   $img"
done

# The store itself, not three echoes of it. Log delivery dropped one of those
# lines on the run that proved this works, which made a passing check look like a
# skipped one -- and `set -e` was the only reason anyone could tell the difference.
# Printing what containerd actually holds cannot be misread that way.
echo "  k3s image store:"
k3s ctr images ls -q 2>/dev/null | grep -E 'platform-worker|managed-worker|vault' | sed 's/^/    /' || true

log "egress probes"
# What the SANDBOX has to reach, not what a browser does. cloud.temporal.io is
# the student's own tab and is not probed here.
probe() {
  if curl -fsS --max-time 10 -o /dev/null "$1"; then echo "  ok   $1"
  elif [ "${WORKSHOP_STRICT_EGRESS:-1}" = "1" ]; then echo "  FAIL $1" >&2; return 1
  else echo "  warn $1 (non-strict)"; fi
}
tcp_probe() { # host:port -- gRPC endpoints have nothing to GET
  if timeout 10 bash -c "cat < /dev/null > /dev/tcp/${1%:*}/${1##*:}" 2>/dev/null; then
    echo "  ok   $1"
  elif [ "${WORKSHOP_STRICT_EGRESS:-1}" = "1" ]; then echo "  FAIL $1" >&2; return 1
  else echo "  warn $1 (non-strict)"; fi
}
if [ -n "${PORTAL_URL:-}" ]; then probe "$PORTAL_URL/healthz"; fi
# A well-known path rather than the root: the registry answers 200 either way,
# but naming the endpoint says what is being asked for.
probe "https://registry.terraform.io/.well-known/terraform.json"

# The Ops API and the data plane, opened rather than fetched.
#
# `probe https://saas-api.tmprl.cloud` used to be here and could never have
# passed: the root of that host answers 404, `curl -f` turns any 404 into a
# non-zero exit, and strict egress turns that into a failed preset build. What we
# actually want to know is whether the port is reachable at all -- the credentialed
# calls that use it are the student's, not ours.
#
# 7233 matters as much as 443 and fails much later: challenge 2's control plane
# dials its regional endpoint, and challenge 4 runs a workflow against
# <namespace>.tmprl.cloud:7233 from this box. A blocked 7233 is invisible until
# then, and looks like a broken worker.
tcp_probe "saas-api.tmprl.cloud:443"
tcp_probe "us-west-2.aws.api.temporal.io:7233"

log "ready"
