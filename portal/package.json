{
  "name": "platform-workshop-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Lab material and live checkpoints for the Temporal platform workshop. Reads the control plane the students built; it has no database of its own.",
  "scripts": {
    "dev": "node scripts/dev-link.mjs && next dev -p ${PORT:-3000}",
    "link:lab": "node scripts/dev-link.mjs",
    "build": "next build",
    "start": "node scripts/dev-link.mjs && next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck"
  },
  "dependencies": {
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1",
    "@next/env": "^15.1.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3"
  }
}
