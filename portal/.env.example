####################################################################
# Access
####################################################################
# The code that opens the portal. It IS the configuration -- not a hash of
# anything, and nothing derived at runtime. 6-32 lowercase alphanumerics or
# dashes; `openssl rand -hex 4` is a good shape.
#
# Rotating it retires every outstanding link at once, which is the emergency stop
# and the normal end-of-cohort action. Expiry is deliberately an ACTION rather
# than a clock: the version of this that expired links at midnight locked students
# out halfway through their own sandbox window.
#
# Deploy as a SECRET (`fly secrets set PORTAL_LINK_CODE=...`), not in fly.toml.
# Six characters off a projector are not much of a secret, but they are the only
# thing between a stranger and the portal, and a value in git is a value that
# outlives the workshop it was for.
PORTAL_LINK_CODE=

# Per-participant view tokens are derived from this:
#
#   token = HMAC-SHA256(secret, participant)[:40]
#
# Set it to the SAME value as the Terraform state service's STATE_SHARED_SECRET.
# One secret and one HMAC scheme then produce every per-participant token in the
# workshop, so a sandbox derives one token that works for both services and there
# is no second list to keep in sync.
#
# Keep it DIFFERENT from PORTAL_LINK_CODE, which is the whole reason both exist:
# rotating the code retires portal links, and if that also rotated this, it would
# break the state-backend auth that fifteen sandboxes are mid-apply with.
#
# openssl rand -hex 32
PORTAL_SHARED_SECRET=

# Guards /instructor, which lists every participant and their progress. Separate
# from the student code on purpose -- the student link gets pasted into chat.
# Omit it and /instructor is unreachable, which is a fine way to run a cohort you
# are not supervising.
#
# openssl rand -hex 24
PORTAL_INSTRUCTOR_TOKEN=

####################################################################
# Temporal Cloud
####################################################################
# The account students provision INTO. Five or six characters after the dot in a
# namespace id -- e.g. the `acct1` in ws-7-orders-prod.acct1.
PORTAL_ACCOUNT_ID=

# The portal's own read credential. Belongs to an INSTRUCTOR identity, never to a
# student: it can see every namespace in the account, which is the point.
#
# It only ever reads -- namespaces, their tags, and service accounts -- so a
# Read-Only account role is enough. Give it the least that works; the portal is a
# lab aid and does not need to be able to change anything.
#
# When this breaks -- expired, revoked, identity deleted -- every student's
# checkpoints go red at once. /healthz makes one authenticated read for exactly
# that reason, so you learn at 09:00 rather than at 15:30.
TEMPORAL_CLOUD_API_KEY=

# Ops API version, sent as the temporal-cloud-api-version header. Pinned so the
# workshop does not break on someone else's release schedule.
PORTAL_CLOUD_API_VERSION=v0.19.1

# Override only for non-production Cloud environments.
PORTAL_CLOUD_API_BASE=https://saas-api.tmprl.cloud

####################################################################
# Cohort
####################################################################
# The denominator on /instructor: "9/15 slots in use". Match it to the slot pool
# capacity the sandbox leases against, or the view will read as over- or
# under-subscribed when it is neither.
PORTAL_COHORT_SIZE=15

# Shown as "Open the sandbox" to anyone who arrives without a usable link. The
# Instruqt invite URL.
PORTAL_SANDBOX_URL=

####################################################################
# Not configured here
####################################################################
# The portal has no database and no Temporal connection.
#
# It cannot reach the control planes students build: each sandbox runs its own
# dev server and nothing out here has ingress to it. Everything the portal renders
# is read live from the Cloud account above -- which is why the reconciler stamps
# `participant` and `drift-corrected-at` into namespace tags, and why the
# checkpoints that depend on a pod or a Vault secret are marked self-attested and
# graded by the Instruqt checks instead.
